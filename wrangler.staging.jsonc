{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sub-store-ui-staging",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "SUB_STORE",
      "service": "sub-store-api-staging"
    }
  ],
  "env": {
    "preview": {
      "services": [
        {
          "binding": "SUB_STORE",
          "service": "sub-store-api-staging"
        }
      ]
    }
  }
}

